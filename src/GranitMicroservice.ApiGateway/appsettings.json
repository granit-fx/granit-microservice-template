{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "Cache": {
    "KeyPrefix": "gateway",
    "EncryptValues": true,
    "Encryption": {
      "Vault": {
        "SecretName": "granit/cache/encryption-key"
      }
    }
  },
  "Vault": {
    "AuthMethod": "Kubernetes",
    "KubernetesRole": "granit-microservice"
  },
  "Bff": {
    "Authority": "http://localhost:8080/realms/granit",
    "SessionDuration": "08:00:00",
    "RefreshGracePeriod": "00:01:00",
    "Frontends": [
      {
        "Name": "spa",
        "ClientId": "granit-gateway",
        "ClientSecret": "gateway-secret-change-in-production",
        "Scopes": [
          "openid",
          "profile",
          "email",
          "roles",
          "offline_access"
        ],
        "PathPrefix": ""
      }
    ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "Match": {
          "Path": "/api/catalog/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api/catalog"
          }
        ],
        "Metadata": {
          "Granit.Bff.RequireAuth": "true",
          "Granit.Bff.Frontend": "spa"
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/identity/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/api"
          }
        ],
        "Metadata": {
          "Granit.Bff.RequireAuth": "true",
          "Granit.Bff.Frontend": "spa"
        }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "default": {
            "Address": "https+http://catalog-service"
          }
        }
      },
      "identity": {
        "Destinations": {
          "default": {
            "Address": "https+http://identity-service"
          }
        }
      }
    }
  },
  "Http": {
    "Cors": {
      "AllowedOrigins": []
    },
    "ApiDocumentation": {
      "OAuth2": {
        "AuthorizationUrl": "http://localhost:8080/realms/granit/protocol/openid-connect/auth",
        "TokenUrl": "http://localhost:8080/realms/granit/protocol/openid-connect/token",
        "ClientId": "granit-spa",
        "EnablePkce": true,
        "Scopes": [
          "openid",
          "profile",
          "email",
          "roles"
        ]
      }
    }
  }
}

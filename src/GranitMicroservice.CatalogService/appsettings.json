{
  "Cache": {
    "KeyPrefix": "catalog"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "WolverinePostgresql": {
    "TransportConnectionStringName": "catalog-db"
  },
  "RateLimiting": {
    "Enabled": true,
    "KeyPrefix": "rl:catalog",
    "BypassRoles": [ "admin" ],
    "FallbackOnCounterStoreFailure": "Allow",
    "Policies": {
      "api-default": {
        "Algorithm": "SlidingWindow",
        "PermitLimit": 1000,
        "Window": "00:01:00",
        "SegmentsPerWindow": 6
      },
      "api-write": {
        "Algorithm": "TokenBucket",
        "TokenLimit": 50,
        "TokensPerPeriod": 10,
        "ReplenishmentPeriod": "00:00:10"
      }
    }
  }
}
